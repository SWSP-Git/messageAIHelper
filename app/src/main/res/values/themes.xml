<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 应用主题：固定 Light 模式 -->
    <style name="Base.Theme.QQAIHelper" parent="Theme.Material3.Light.NoActionBar">
        <!-- 全局 AlertDialog 使用自定义主题（带缩放动画） -->
        <item name="alertDialogTheme">@style/AppAlertDialogTheme</item>
    </style>

    <style name="Theme.QQAIHelper" parent="Base.Theme.QQAIHelper" />

    <!-- AlertDialog 自定义主题：透明背景 + 缩放动画 -->
    <style name="AppAlertDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowAnimationStyle">@style/AppDialogAnimation</item>
    </style>

    <!-- 弹窗动画样式 -->
    <style name="AppDialogAnimation">
        <item name="android:windowEnterAnimation">@anim/dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_exit</item>
    </style>
</resources>
